#!/bin/sh
# Push só para refs/heads/feature/* (AD-001). O git envia uma linha por ref no stdin.

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/feature/?*) ;;
    *)
      echo "push recusado para '$remote_ref': só refs/heads/feature/* é permitido" >&2
      status=1
      ;;
  esac
done

exit "$status"
