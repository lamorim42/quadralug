# Copiado para .env por `make setup`. Valores só para desenvolvimento local.
# MYSQL_PASSWORD entra em uma URL: use letras, números, hífen ou sublinhado.
MYSQL_ROOT_PASSWORD=troque-root
MYSQL_DATABASE=quadralug
MYSQL_USER=quadralug
MYSQL_PASSWORD=troque-app
DEPLOYMENT_ENVIRONMENT=dev
# Vazio desliga o exportador OTLP.
OTEL_EXPORTER_OTLP_ENDPOINT=
